# Urban Digital Twin — optional environment. Everything here has a working
# default; the twin boots and runs with none of it set.

# --- Feature switches ------------------------------------------------------
TWIN_ENABLED=1
TWIN_SCHEDULER_ENABLED=1

# --- Live incident feeds (all keyless) -------------------------------------
TWIN_SACHET_STATES=karnataka,telangana   # NDMA SACHET state CAP feeds
TWIN_ALERT_POLL_MIN=5                    # how often to poll them
TWIN_GLOBAL_FEEDS_ENABLED=1              # GDACS + USGS

# --- Triage agent ----------------------------------------------------------
# TWIN_AGENT_ENABLED=0 is a fully supported steady state: the triage job is
# never scheduled and the rest of the twin is unaffected.
TWIN_AGENT_ENABLED=1
TWIN_FLAG_THRESHOLD=60                   # risk score above which a flag is raised
TWIN_AGENT_MAX_ITEMS=40                  # per-run cap, so a loud feed day is bounded
TWIN_LLM_TIMEOUT_S=90

# The model is served through OpenRouter, the same gateway the host app already
# uses for image analysis. Default is the non-reasoning Kimi: the reasoning
# variants (kimi-k2.5, kimi-k2-thinking) cost roughly 5x the tokens for
# identical extraction output, because most of the budget goes on chain of
# thought that classification at temperature 0 does not need.
TWIN_AGENT_MODEL=moonshotai/kimi-k2-0905

# Key lookup order: KIMI_API_KEY, then OPENROUTER_API_KEY, then TWIN_LLM_API_KEY.
# With none of them set the agent still runs, on deterministic fallbacks, and
# every brief it writes is marked "generated without a language model".
# KIMI_API_KEY=

# --- Grid & compute --------------------------------------------------------
# TWIN_H3_RESOLUTION=8
# TWIN_GRID_RINGS=17
# TWIN_COMPUTE_INTERVAL_MIN=5

# --- Optional keyed sources (each adds one layer; none is required) --------
# The ONLY source of genuinely live camera imagery. OpenStreetMap maps camera
# *locations*, not feeds - not one of Bengaluru's 2,891 mapped cameras carries a
# contact:webcam tag - so without this key the imagery panel can only show
# archival street-level photography, and it says so on every frame.
# Free tier: https://api.windy.com/webcams
# WINDY_WEBCAMS_KEY=

# Denser street-level photography than KartaView alone, especially in Indian
# wards. Still archival, not live.
# MAPILLARY_TOKEN=

# TOMTOM_API_KEY=
