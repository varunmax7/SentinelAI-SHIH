# Urban Digital Twin — optional environment. Everything here has a working
# default; the twin boots and runs with none of it set.

# --- Feature switches ------------------------------------------------------
TWIN_ENABLED=1
TWIN_SCHEDULER_ENABLED=1

# --- Live incident feeds (all keyless) -------------------------------------
TWIN_SACHET_STATES=karnataka,telangana   # NDMA SACHET state CAP feeds
TWIN_ALERT_POLL_MIN=5                    # how often to poll them
TWIN_GLOBAL_FEEDS_ENABLED=1              # GDACS + USGS

# --- Triage agent ----------------------------------------------------------
# TWIN_AGENT_ENABLED=0 is a fully supported steady state: the triage job is
# never scheduled and the rest of the twin is unaffected.
TWIN_AGENT_ENABLED=1
TWIN_FLAG_THRESHOLD=60                   # risk score above which a flag is raised
TWIN_AGENT_MAX_ITEMS=40                  # per-run cap, so a loud feed day is bounded
TWIN_LLM_TIMEOUT_S=90

# The model is served through OpenRouter, the same gateway the host app already
# uses for image analysis. Default is the non-reasoning Kimi: the reasoning
# variants (kimi-k2.5, kimi-k2-thinking) cost roughly 5x the tokens for
# identical extraction output, because most of the budget goes on chain of
# thought that classification at temperature 0 does not need.
TWIN_AGENT_MODEL=moonshotai/kimi-k2-0905

# Key lookup order: KIMI_API_KEY, then OPENROUTER_API_KEY, then TWIN_LLM_API_KEY.
# With none of them set the agent still runs, on deterministic fallbacks, and
# every brief it writes is marked "generated without a language model".
# KIMI_API_KEY=

# --- Grid & compute --------------------------------------------------------
# TWIN_H3_RESOLUTION=8
# TWIN_GRID_RINGS=17
# TWIN_COMPUTE_INTERVAL_MIN=5

# --- Anomaly baselines -------------------------------------------------------
# "Unusual for THIS place" - a 5-year climatology per sample point, compared
# in standard deviations. Nothing is "unusual" until scripts/backfill_baselines.py
# has run at least once (see IMPLEMENTATION_TWIN.md).
# TWIN_BASELINE_YEARS=5
# TWIN_ANOMALY_SIGMA_WATCH=1.5
# TWIN_ANOMALY_SIGMA_ALERT=2.5

# --- Flag dispatch -----------------------------------------------------------
# The only path from an approved flag to a real phone
# (POST /api/twin/flags/<id>/dispatch). All three guard rails below apply
# regardless of how large a flag's cell footprint is.
# TWIN_DISPATCH_COOLDOWN_MIN=30
# TWIN_DISPATCH_MAX_RADIUS_KM=25
# TWIN_DISPATCH_BUFFER_KM=1.5

# --- Forecast agent (keyless - wind advection, no key needed) ---------------
# Independent of TWIN_AGENT_ENABLED: triage reads what is true now, forecast
# projects what wind is carrying toward the city. Either can run without the
# other; both write to the same flag queue. See IMPLEMENTATION_TWIN.md.
# TWIN_FORECAST_ENABLED=1

# --- RAG ---------------------------------------------------------------------
# Keyword-scored retrieval over data/twin/corpus/ - no embedding model, no key.
# Empty corpus (the shipped default) means briefs simply carry no citations.
# TWIN_RAG_CORPUS_DIR=data/twin/corpus

# --- Live stations & transit --------------------------------------------------
# Unlike every other adapter in this app, NONE of the three station sources
# below has a keyless tier - set at least one to get real AQ station data.
# TWIN_STATION_POLL_MIN=15
# TWIN_TRANSIT_POLL_MIN=2
# TWIN_STATION_STALE_MIN=120               # a reading older than this is shown, but marked stale
# TWIN_TRANSIT_VEHICLE_MAX_AGE_MIN=30      # older than this, a vehicle is dropped, not shown frozen
# TWIN_TRANSIT_STALL_SPEED_KMH=3.0

# OPENAQ_API_KEY=
# AQICN_TOKEN=                             # city-name feed only - see stations.py on why
# DATA_GOV_IN_KEY=                         # CPCB. Not obtained while building this (see docs)

# GTFS-Realtime, per city. No stable public feed exists for Hyderabad or
# Bengaluru as of writing - this layer is complete and simply empty until a
# deployment sets it. `pip install gtfs-realtime-bindings` is also required
# once a URL is set (lazily imported, so it's not needed until then).
# TWIN_GTFS_RT_URLS={"hyderabad": "https://.../vehicle_positions.pb"}
# TWIN_GTFS_STATIC_URLS={}
# TWIN_GTFS_RT_HEADERS={}

# --- Operator camera feeds ----------------------------------------------------
# A JSON file, not a key - see cameras.py. Ships as an empty array; add an
# entry the moment real GHMC/Bengaluru ICCC/police access exists. The server
# never fetches these URLs itself - the browser loads them directly.
# TWIN_CCTV_STREAMS_FILE=data/twin/cctv_streams.json

# --- Optional keyed sources (each adds one layer; none is required) --------
# The ONLY source of genuinely live camera imagery. OpenStreetMap maps camera
# *locations*, not feeds - not one of Bengaluru's 2,891 mapped cameras carries a
# contact:webcam tag - so without this key the imagery panel can only show
# archival street-level photography, and it says so on every frame.
# Free tier: https://api.windy.com/webcams
# WINDY_WEBCAMS_KEY=

# Denser street-level photography than KartaView alone, especially in Indian
# wards. Still archival, not live.
#
# The token must have "read" scope granted in the Mapillary developer
# dashboard. A token without it does not error - every query answers HTTP 200
# with an empty list, which is indistinguishable from "this city has no
# coverage" unless you know to look. The Ground board reports such a token as
# `blocked`, with that reason, rather than letting it read as a coverage gap.
# MAPILLARY_TOKEN=

# TOMTOM_API_KEY=

# --- OSINT feeds (twin/osint.py) -------------------------------------------
# Open-source intelligence layered onto the city map, all verified against
# their live endpoints while building this:
#
#   aircraft  OpenSky Network, keyless. Live ADS-B. Verified: 25 aircraft over
#             the Bengaluru box, 0 over Hyderabad in the same instant - which
#             is the right answer at 22:45 IST, not a failure.
#   seismic   EMSC seismicportal.eu, keyless. Verified: real M2.8-M3.6 events
#             in Karnataka/Andhra within 250 km. Chosen alongside the existing
#             USGS feed because EMSC's regional threshold over India is much
#             lower - USGS rarely lists anything under M4.5 here.
#   events    NASA EONET v3, keyless. Open natural-event tracks.
#   news      GDELT 2.0, keyless. Verified: real Hyderabad rain/traffic
#             reporting. Its rate limit is strict (one call per 5 s per
#             caller) and it WILL answer 429 under load - that is reported as
#             `throttled`, never as "no news".
#
# TWIN_OSINT_RADIUS_KM=250            # how far from the city centre to look
# TWIN_OSINT_MAX_PER_KIND=120
# TWIN_OSINT_AIRCRAFT_TTL_S=60        # aircraft go stale in seconds
# TWIN_OSINT_SEISMIC_DAYS=30
# TWIN_OSINT_SEISMIC_MIN_MAG=2.5      # below this nobody felt it
# TWIN_OSINT_EVENTS_DAYS=30
# TWIN_OSINT_NEWS_DAYS=3
# TWIN_OSINT_NEWS_MIN_INTERVAL_S=6    # GDELT's published minimum is 5 s
# TWIN_OSINT_NEWS_COOLDOWN_S=300      # after a 429, stop asking for this long
# TWIN_OSINT_NEWS_TERMS=flood,rain,cyclone,landslide,fire,collapse,rescue,...
#
# NOTE ON NEWS RELEVANCE. These terms narrow the GDELT query, but GDELT still
# matches loosely - with them set it returned an Australian cricket coach,
# Kerala aviation politics, and one US syndicated climate feature four times
# from four American local-TV domains. So three more things happen after the
# fetch, in twin/osint.py: `sourcecountry:IN` is added to the query, results
# are de-duplicated on a normalised title, and every headline is re-checked
# against NEWS_HAZARD_PATTERNS - which match PHRASES ("heavy rain") rather
# than bare words, because "rain" alone is a cricket delay. A headline
# matching nothing is dropped; a disaster map that lists cricket teaches an
# analyst to stop reading it.
#
# Satellite thermal anomalies (active fires). Free key, no card:
#   https://firms.modaps.eosdis.nasa.gov/api/map_key
# Without it the fire layer reports `unconfigured` and draws nothing - it
# never guesses. NOTE: FIRMS answers a bad key with HTTP 200 and a plain-text
# body, so a wrong key would otherwise parse as "zero fires" and read on the
# map as "nothing is burning"; the adapter checks for the CSV header instead.
# FIRMS_MAP_KEY=
# FIRMS_PRODUCT=VIIRS_SNPP_NRT
#
# Per-point OSINT, shown in the cell drawer. Wider than a cell because the
# things it reports are wide: an aircraft at cruise 20 km away is overhead as
# far as an operator is concerned. When nothing falls inside the radius the
# drawer still reports the nearest of each kind with its real distance -
# silence would read as a broken feed rather than as "nothing is close".
# TWIN_OSINT_NEAR_RADIUS_KM=25
# TWIN_OSINT_NEAR_MAX=20
# TWIN_OSINT_NEAR_NEWS=5
# How close a live camera must be before it can be said to cover a point at
# all. Beyond this it is listed as "the nearest camera is N km away".
# TWIN_OSINT_CAMERA_COVER_KM=1.5

# --- City-wide ground imagery board (twin/ground.py) ----------------------
# The "Ground" button in the twin header opens one board of every location in
# the selected city that has a picture: live webcam frames, photos attached to
# this app's own reports, and archival street-level photography, each labelled
# with its source and real age. Every default below is sensible; none is
# required.
#
# How many points to look at. These are the city's own zone centres, so the
# effective ceiling is the number of zones (8 per city today).
# TWIN_GROUND_POINTS_PER_CITY=12
# TWIN_GROUND_IMAGES_PER_POINT=6
# KartaView's API hard-caps its own radius at 500 m; raising this past that
# changes nothing for that provider.
# TWIN_GROUND_STREET_RADIUS_M=500
# How long a frame may be served under a LIVE badge. Keep it short - the badge
# is a claim about the present, and a longer cache breaks it.
# TWIN_GROUND_WEBCAM_TTL_S=60
# Archival photography does not change; re-querying it per board build would be
# hundreds of round trips for identical answers.
# TWIN_GROUND_ARCHIVE_TTL_S=86400
# How far back a report photo still appears on the board (30 days). Longer than
# the 72 h that lets a report move a risk score - an older report is no longer
# evidence of current risk but is still the best photograph of that street.
# TWIN_GROUND_REPORT_LOOKBACK_H=720
# TWIN_GROUND_REPORT_LIMIT=24
# TWIN_GROUND_MAX_WORKERS=8

# --- Per-cell imagery coverage --------------------------------------------
# Why these exist: with a single KartaView query per cell, roughly half of all
# cells came back with no photograph of their own and fell through to the
# shared city webcam - which is the SAME two frames everywhere in Hyderabad
# and the same one frame everywhere in Bengaluru. That is what makes eight
# different locations look like they have the same picture.
#
# KartaView's API hard-caps `radius` at 500 m, narrower than an H3 res-8 cell,
# so "search wider" has to mean "more legal 500 m queries" rather than one
# bigger one. Measured on 24 random Hyderabad cells: 14/24 had a photo with a
# single query, 19/24 with the 5-point ring, and the median cell went from 1
# photo to 5. Set RING_POINTS=1 to go back to a single query.
# TWIN_STREETVIEW_RING_POINTS=5
# TWIN_STREETVIEW_RING_STEP_M=420
#
# The widened search, used only when the close ring found nothing at all.
# Measured on five cells with zero close coverage: four found real photographs
# at these radii in 1-2 s. Anything found this way is captioned with its true
# distance, never presented as a picture of this exact spot.
# TWIN_STREETVIEW_WIDE_RING_STEPS_M=1300,2600
# TWIN_STREETVIEW_WIDE_RING_POINTS=6
#
# How close a citizen report photo must be to count as a picture of this point.
# TWIN_STREETVIEW_REPORT_RADIUS_M=700
#
# The floor: a satellite crop of the exact point, from the Esri World Imagery
# service already used as the basemap (no key, no proxying - the browser loads
# it directly, same as the basemap tiles). Every location gets one, so no
# location is ever left with only the shared city webcam. ~400 m is about one
# H3 res-8 cell across.
# TWIN_AERIAL_SPAN_M=400
# TWIN_AERIAL_SIZE_PX=512

# --- AI Disaster Prediction Agent -------------------------------------------
# Watches live wind/cloud/fire-danger signal (Open-Meteo, keyless) across a
# curated grid of Indian regions and projects downwind hazard hotspots for the
# analyst dashboard. See IMPLEMENTATION.md. Reuses the same LLM key/model as
# the twin's triage agent above - nothing new to set for narration; with no
# key it still runs, on a deterministic template narrative.
DISASTER_AGENT_ENABLED=1
DISASTER_AGENT_SCHEDULER_ENABLED=1
DISASTER_AGENT_CYCLE_MIN=20              # minutes between automatic cycles

# How far ahead the hourly forecast is pulled, in days. This is the ceiling on
# how long a hazard window can be: the agent re-scores each forecast hour with
# the same function that produces the headline number, and reads the start,
# peak and end of the above-threshold stretch off that timeline
# (disaster_agent/window.py). Past this horizon there is no data, so a signal
# still elevated at the edge is reported as open-ended - "no end time in the
# data yet" - never given an invented end.
DISASTER_AGENT_FORECAST_DAYS=3

# TWIN_ENABLED=0 does NOT disable this - disaster_agent only *imports*
# twin.llm for its LLM client, it does not require the twin feature to be on.
# DISASTER_AGENT_SOURCE_MIN=35           # source signal floor, 0-100
# DISASTER_AGENT_HOTSPOT_THRESHOLD=50    # hotspot floor, 0-100
# DISASTER_AGENT_BEARING_TOLERANCE_DEG=55
# DISASTER_AGENT_MAX_NARRATED=10         # LLM calls per cycle, cost cap

# --- Vision models (utils.py::vision_routes) --------------------------------
# Used by BOTH the report-photo grader and the twin's ground-imagery captions.
# Providers are tried in order: OpenAI first (billed, reliable), then the free
# OpenRouter models as a genuine fallback so a billing or quota wall degrades
# to a free caption rather than to no caption.
#
# Verified 2026-09-24 against a real street photo with the production prompt:
#   gpt-4.1-mini                       2.2s,   539 tokens   <- default
#   gpt-5.4-nano                       4.6s,   446 tokens
#   gpt-4o-mini                        4.1s, 14316 tokens   (works; ~26x the
#                                      tokens of gpt-4.1-mini, so not used)
#   nex-agi/nex-n2.5-mini:free         4.3s   (OpenRouter)
#   nvidia/nemotron-3-nano-...:free    4.5s   (OpenRouter)
#   google/gemma-4-31b-it:free         5.3s   (OpenRouter)
#
# Retired/rejected, each verified:
#   inclusionai/ling-3.0-flash-vl:free   HTTP 404, now paid-only. This was the
#                                        old fallback and is what surfaced to
#                                        analysts as a raw 404 error string.
#   thinkingmachines/inkling-small:free  HTTP 403, agentic harnesses only.
#   dots-studio/dots-3-note-preview:free 200 but never parseable JSON.
#   nex-agi/nex-n2.5-pro:free            200 but 37s, past every deadline.
#
# OPENAI_API_KEY=sk-proj-...          # primary; any vision-capable model
# OPENAI_VISION_MODELS=gpt-4.1-mini,gpt-5.4-nano
#
# OpenRouter keys, tried in turn (all of them, not just the first present one
# - a key that is set but EXPIRED is exactly the case a plain `A or B` misses).
# OPENROUTER_API_KEY=
# KIMI_API_KEY=
# NVIDIA_API_KEY=                     # NOTE: currently expired (HTTP 401)
#
# Pin a specific OpenRouter model ahead of the verified chain:
# NVIDIA_VISION_MODEL=
# VISION_FALLBACK_MODEL=

# --- Re-photograph detection (utils.py) -------------------------------------
# A citizen photographing a flood picture displayed ON A LAPTOP SCREEN was
# being graded as a genuine field photo - the model described the flood
# accurately and never mentioned the macOS dock, Touch Bar and F4-F9 keys
# filling the bottom third, because nothing had asked it to look. The prompt
# now asks about provenance and the hazard as two independent questions.
#
# Verified on that exact submission: gpt-4.1-mini returned capture_medium
# "screen" at 0.95 citing "visible laptop keyboard, screen bezels, and desktop
# taskbar"; gpt-5.4-nano agreed at 0.95. A genuine outdoor photo scored
# "direct_photo" at 0.90, so 0.70 sits clear of both.
#
# EXIF is deliberately NOT used to corroborate. Checked directly: every photo
# taken through this app's own camera widget carries ZERO EXIF tags, because
# the browser canvas capture path strips them. An "absent EXIF is suspicious"
# rule would flag every legitimate in-app capture while missing this case
# entirely, since a phone photo of a screen has perfectly normal camera EXIF.
# REPHOTOGRAPH_MIN_CONFIDENCE=0.70
# Capped, not zeroed - the hazard shown may be real and worth an analyst's
# eye. A detection is ALSO a hard block on auto-approval, independent of any
# score, so reweighting a parameter cannot silently re-open the hole.
# REPHOTOGRAPH_SCORE_CAP=0.25
